# To generate this base64 string securely:
# 1. Download your 'serviceAccountKey.json' from Firebase Console -> Project Settings -> Service Accounts
# 2. Encode it to base64:
#    - On Windows PowerShell run: 
#      [convert]::ToBase64String((Get-Content -path "serviceAccountKey.json" -Encoding byte))
#    - On Mac/Linux terminal run: 
#      base64 -i serviceAccountKey.json | tr -d '\n'
# 3. Paste the extremely long resulting string below without quotes:

FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_string_here

PORT=3000
